# Use your computer's LAN IP for a physical device, or the HTTPS deployed backend.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Web OAuth client ID: must match server MOBILE_GOOGLE_AUDIENCE (or AUTH_GOOGLE_ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Native application identifiers; configure matching OAuth clients.
MOBILE_APP_ID=com.frontlanejobs.mobile
# Optional EAS project ID, assigned after linking the project.
EAS_PROJECT_ID=
