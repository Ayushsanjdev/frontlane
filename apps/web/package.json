{
  "name": "@frontlanejobs/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --import ./scripts/load-env.mjs node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3000",
    "build": "node --import ./scripts/load-env.mjs node_modules/vite/bin/vite.js build",
    "start": "node --import ./scripts/load-env.mjs build/index.js",
    "preview": "node --import ./scripts/load-env.mjs node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 3000",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:browser": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@auth/sveltekit": "1.11.3",
    "@fontsource-variable/manrope": "5.3.0",
    "@frontlanejobs/core": "workspace:*",
    "@frontlanejobs/database": "workspace:*",
    "@lucide/svelte": "1.55.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "files": [
    "build",
    "scripts/load-env.mjs"
  ]
}
