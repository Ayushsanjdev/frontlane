# Set these in your hosting dashboard. Never commit the real .env.local.
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
DATABASE_URL=postgresql://frontlane:CHANGE_ME@localhost:5432/frontlane
# For managed PostgreSQL, enable valid-certificate TLS as required by the provider.
DB_SSL=false
DB_POOL_SIZE=5
# Separate random secrets, each at least 32 characters.
INGEST_TOKEN=
CRON_SECRET=
# Server-only Brave Web Search key. Discovery caps attempts at 30/day and 1,000/month (UTC).
BRAVE_SEARCH_API_KEY=
# Mobile ID tokens must target this web OAuth client; defaults to AUTH_GOOGLE_ID.
MOBILE_GOOGLE_AUDIENCE=

# Optional daily email digests. Verify your sending domain and register the signed webhook.
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
# Disable anonymous aggregate product metrics when required.
DISABLE_PRODUCT_METRICS=false
